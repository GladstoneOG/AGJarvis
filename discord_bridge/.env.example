# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset/Copy Token)
DISCORD_BOT_TOKEN=

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (Optional) Your Discord Server (Guild) ID for instant slash command synchronization
# Right click your server name in Discord -> Copy Server ID (requires Developer Mode enabled in Discord settings)
DISCORD_GUILD_ID=
